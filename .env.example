# OpenAI
OPENAI_API_KEY=sk-...
# Pace chat/completions. Default 4s in code if unset. For very low RPM (e.g. 3/min) use ceil(60/RPM)+1.
OPENAI_MIN_INTERVAL=22

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google AI Studio / Gemini (optional; https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# HuggingFace (for inference API and model downloads)
HF_TOKEN=hf_...

# Model selection for AI generation (comma-separated; rotate per file index)
# OpenAI, Anthropic, Google: names as below. HuggingFace: org/model id.
AI_GENERATION_MODELS=gpt-4-turbo,claude-3-5-sonnet-20241022,gemini-1.5-flash,codellama/CodeLlama-34b-Instruct-hf,bigcode/starcoder2-15b

# Dataset construction
NUM_PROBLEMS=500
MIN_ACCEPTED_SOLUTIONS=10
AI_SOLUTIONS_PER_PROBLEM=5

# Project_CodeNet root (folder containing metadata/, problem_descriptions/, data/, derived/)
# If unset, auto-detected under DATA_DIR/downloads/...
CODENET_ROOT=

# AI-CodeNet output (mirrors CodeNet tree + extended metadata CSVs)
AI_CODENET_ROOT=data/ai_codenet
MERGED_CODENET_ROOT=data/merged_codenet
MAX_CODENET_PROBLEMS=
AI_CODENET_RUN_TESTS=true
AI_CODENET_RATE_SLEEP=1.2
MERGE_TRAIN_RATIO=0.80
MERGE_VAL_RATIO=0.10
MERGE_TEST_RATIO=0.10

# Gemini (AI-CodeNet pipeline; alias for GOOGLE_API_KEY)
GEMINI_API_KEY=

# CodeBERT fine-tuning (optional; defaults exist in config/settings.py)
# CODEBERT_SAVE_STEPS=250
# CODEBERT_SAVE_TOTAL_LIMIT=8
# CODEBERT_PATIENCE=6
# Inference: sigmoid(logit/T). Default 1.0 = raw classifier. Prefer calibration file from:
#   python scripts/fit_codebert_temperature.py
# CODEBERT_INFERENCE_TEMPERATURE=1.0

# Paths
DATA_DIR=data
CODENET_URL=https://dax-cdn.cdn.appdomain.cloud/dax-project-codenet/1.0.0/Project_CodeNet.tar.gz

# API settings
API_HOST=0.0.0.0
API_PORT=8000

# TraceCoder login & scan history (SQLite under DATA_DIR by default)
JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRE_HOURS=168
# TRACECODER_DB_PATH=data/tracecoder.db
# GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Supabase (recommended auth + history)
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  # backend only, never expose to browser
# SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-api-settings
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_HISTORY_TABLE=scan_history
# SUPABASE_USERS_TABLE=app_users

# Thresholds
THRESHOLD_AUTO_ACCEPT=0.4
THRESHOLD_FLAG_REVIEW=0.7
